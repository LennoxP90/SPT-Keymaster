<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Keymaster.Server.Web</RootNamespace>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <PathMap>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), ..))=Keymaster\</PathMap>
  </PropertyGroup>

  <PropertyGroup>
    <SptRefDir></SptRefDir>
    <SptPackageVersion>4.1.3</SptPackageVersion>
    <SptRefsPresent>false</SptRefsPresent>
    <SptRefsPresent Condition="Exists('$(SptRefDir)\SPTarkov.Server.Core.dll')">true</SptRefsPresent>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keymaster.Server\Keymaster.Server.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(SptRefsPresent)' != 'true'">
    <PackageReference Include="SPTushonka.Server.Core" Version="$(SptPackageVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.Server.Web" Version="$(SptPackageVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.DI" Version="$(SptPackageVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.Common" Version="$(SptPackageVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(SptRefsPresent)' == 'true'">
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SptRefDir)\SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Server.Web"><HintPath>$(SptRefDir)\SPTarkov.Server.Web.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(SptRefDir)\SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(SptRefDir)\SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MudBlazor"><HintPath>$(SptRefDir)\MudBlazor.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="ValidateSptCoreFloor" BeforeTargets="ResolveAssemblyReferences" Condition="'$(SptRefsPresent)' == 'true'">
    <GetAssemblyIdentity AssemblyFiles="$(SptRefDir)\SPTarkov.Server.Core.dll">
      <Output TaskParameter="Assemblies" ItemName="SptCoreLocalAssembly" />
    </GetAssemblyIdentity>

    <PropertyGroup>
      <SptCoreLocalVersionRaw>@(SptCoreLocalAssembly->'%(Version)')</SptCoreLocalVersionRaw>
      <SptCoreLocalVersion>$(SptCoreLocalVersionRaw.Split('.')[0]).$(SptCoreLocalVersionRaw.Split('.')[1]).$(SptCoreLocalVersionRaw.Split('.')[2])</SptCoreLocalVersion>
    </PropertyGroup>

    <Error
        Condition="$([MSBuild]::VersionGreaterThan('$(SptCoreLocalVersion)', '$(SptPackageVersion)'))"
        Text="Keymaster.Server.Web: the local install at $(SptRefDir) carries SPTarkov.Server.Core $(SptCoreLocalVersion), above the declared floor SptPackageVersion=$(SptPackageVersion). Building against it as-is would silently raise the mod's real minimum server version, since ModValidator.ValidateCoreAssemblyReference throws out of the mod loader on any server below the compile-time Core. Either raise SptPackageVersion (and ModMetadata.cs's SptVersion) to $(SptCoreLocalVersion) as a deliberate decision, or point SptRefDir at an install at or below $(SptPackageVersion)." />
  </Target>

  <PropertyGroup>
    <KeymasterDist>$(MSBuildProjectDirectory)\..\dist\$(Configuration)\SPT_Runtime\user\mods\LennoxP90-Keymaster</KeymasterDist>
  </PropertyGroup>

  <!-- Only the page assembly: it has no wwwroot and no dependencies of its own (MudBlazor and SPT ship with the server). -->
  <Target Name="StageKeymasterServerWeb" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(KeymasterDist)" SkipUnchangedFiles="true" />
  </Target>

</Project>
